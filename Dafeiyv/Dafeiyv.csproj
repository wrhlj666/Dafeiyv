<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>   <!-- 系统托盘图标（NotifyIcon） -->
    <ApplicationIcon>ico\dafeiyv.ico</ApplicationIcon>   <!-- exe 程序图标 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>   <!-- IconLoader 用指针读像素 -->
    <!-- 项目里已有源 AssemblyInfo.cs（ThemeInfo），关闭 SDK 自动生成的 AssemblyInfo，
         避免与 WPF 临时编译工程（wpftmp）生成的 AssemblyInfo 冲突（attribute 重复） -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WpfAnimatedGif" Version="2.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms 仅用于托盘图标（NotifyIcon）；移除其隐式全局 using，避免与 WPF 类型重名 -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- 一键包含所有 GIF，以后加新图自动生效 -->
    <Content Include="Idle\*.gif">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Images\*.gif">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Interact\*.gif">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="ico\dafeiyv.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Interact\" />
  </ItemGroup>

</Project>

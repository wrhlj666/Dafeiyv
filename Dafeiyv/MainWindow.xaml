<Window x:Class="Dafeiyv.MainWindow"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Dafeiyv"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Title="MainWindow" 
        Height="400" 
        Width="260"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Grid x:Name="RootGrid"
          Width="260"
          Height="400"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          RenderTransformOrigin="0,0"
          MouseLeftButtonDown="Grid_MouseLeftButtonDown"
      MouseMove="Grid_MouseMove"
      MouseLeftButtonUp="Grid_MouseLeftButtonUp"
      LostMouseCapture="Grid_LostMouseCapture">

        <!-- 右键菜单 -->
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="💬 对话记录" Click="Menu_ShowHistory_Click"/>
                <MenuItem Header="🎮 互动">
                    <MenuItem Header="🤲 摸头" Click="Menu_ActionPet_Click"/>
                    <MenuItem Header="💥 砸" Click="Menu_ActionHit_Click"/>
                    <MenuItem Header="🔨 敲" Click="Menu_ActionBonk_Click"/>
                    <MenuItem Header="👋 打招呼" Click="Menu_ActionGreet_Click"/>
                    <MenuItem Header="⛓️ 蹲大牢" Click="Menu_ActionJail_Click"/>
                </MenuItem>
                <MenuItem Header="🧩 数独" Click="Menu_Sudoku_Click"/>
                <MenuItem Header="💰 查询余额" Click="Menu_Balance_Click"/>
                <MenuItem Header="⚙️ 设置" Click="Menu_Settings_Click"/>
                <MenuItem Header="🎯 物理效果" Click="Menu_PhysicsToggle_Click" IsCheckable="True"/>
                <Separator/>
                <MenuItem Header="❌ 退出" Click="Menu_Exit_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <Grid Background="Transparent" />

        <!-- 气泡 -->
        <Border x:Name="BubbleBorder"
                Background="#FFFFFF"
                BorderBrush="#333333"
                BorderThickness="2"
                CornerRadius="15"
                Padding="12,8"
                MaxWidth="220"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,280"
                Visibility="Collapsed">

            <TextBlock x:Name="BubbleText"
                       Text="你好！"
                       FontSize="14"
                       Foreground="#333333"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
        </Border>

        <!-- 桌宠 GIF -->
        <Image x:Name="PetImage"
               gif:ImageBehavior.AnimatedSource="{Binding CurrentGifPath, RelativeSource={RelativeSource AncestorType=Window}}"
               gif:ImageBehavior.RepeatBehavior="Forever"
               Margin="0,110,0,30" />

        <!-- 输入框 -->
        <Border x:Name="InputPanel"
                Background="#FFFFFF"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                CornerRadius="20"
                Padding="10,5"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,15"
                Width="230"
                Height="30"
                Visibility="Collapsed">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="InputTextBox"
                         Grid.Column="0"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="13"
                         VerticalContentAlignment="Center"
                         KeyDown="InputTextBox_KeyDown"
                         Margin="0,0,5,0">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Content="发送"
                        Width="45"
                        Height="Auto"
                        FontSize="13"
                        Padding="0"
                        Background="#4CAF50"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="SendButton_Click" />
            </Grid>
        </Border>

        <!-- 底部状态小字：余额 · 峰谷期（跟随输入框显隐） -->
        <TextBlock x:Name="StatusLineText"
                   FontSize="10"
                   Foreground="#8C8C8C"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,1"
                   Text=""
                   IsHitTestVisible="False"
                   Visibility="{Binding Visibility, ElementName=InputPanel}" />
    </Grid>
</Window>
<Window x:Class="Dafeiyv.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="⚙️ 桌宠设置" 
        Height="790" 
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        MinHeight="600"
        MinWidth="450">

    <!-- 内容超出窗口时自动滚动，适配不同屏幕高度 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" 
                   Text="⚙️ 桌宠设置" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Margin="0,0,0,15"/>

        <!-- API Key -->
        <TextBlock Grid.Row="1" 
                   Text="🔑 API Key" 
                   FontWeight="Bold" 
                   Margin="0,0,0,5"/>
        <PasswordBox x:Name="ApiKeyPasswordBox" 
                     Grid.Row="2" 
                     Height="32" 
                     FontSize="13"
                     Margin="0,0,0,12"
                     Visibility="Visible"/>
        <TextBox x:Name="ApiKeyTextBox" 
                 Grid.Row="2" 
                 Height="32" 
                 FontSize="13"
                 Margin="0,0,0,12"
                 Visibility="Collapsed"/>

        <!-- System Prompt -->
        <TextBlock Grid.Row="3" 
                   Text="📝 系统提示词（System Prompt）" 
                   FontWeight="Bold" 
                   Margin="0,0,0,5"/>
        <TextBox x:Name="PromptBox" 
                 Grid.Row="4" 
                 Height="90" 
                 FontSize="13"
                 TextWrapping="Wrap" 
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 Margin="0,0,0,10"/>

        <!-- 显示密码复选框 -->
        <CheckBox x:Name="ShowPasswordCheckBox" 
                  Grid.Row="5"
                  Content="👁️ 显示 API Key"
                  Margin="0,0,0,12"
                  Checked="ShowPasswordCheckBox_Checked"
                  Unchecked="ShowPasswordCheckBox_Unchecked"
                  HorizontalAlignment="Left"/>

        <!-- 宠物大小 -->
        <TextBlock Grid.Row="6" 
                   Text="🐟 宠物大小" 
                   FontWeight="Bold" 
                   Margin="0,0,0,5"/>
        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="PetSizeSlider"
                    Grid.Column="0"
                    Minimum="50"
                    Maximum="200"
                    Value="100"
                    TickFrequency="5"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    ValueChanged="PetSizeSlider_ValueChanged"/>
            <TextBlock x:Name="PetSizeValueText"
                       Grid.Column="1"
                       Text="100%"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="13"
                       TextAlignment="Right"/>
        </Grid>

        <!-- 随机动作间隔 -->
        <TextBlock Grid.Row="8" 
                   Text="🎲 随机动作触发间隔（秒）" 
                   FontWeight="Bold" 
                   Margin="0,12,0,5"/>
        <Grid Grid.Row="9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="IdleIntervalSlider"
                    Grid.Column="0"
                    Minimum="10"
                    Maximum="120"
                    Value="10"
                    TickFrequency="5"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    ValueChanged="IdleIntervalSlider_ValueChanged"/>
            <TextBlock x:Name="IdleIntervalValueText"
                       Grid.Column="1"
                       Text="10 秒"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="13"
                       TextAlignment="Right"/>
        </Grid>

        <!-- 主动说话 -->
        <CheckBox x:Name="ProactiveSpeakCheckBox"
                  Grid.Row="10"
                  Content="🗣️ 主动说话（用户长时间未互动自己开口）"
                  FontWeight="Bold"
                  Margin="0,12,0,5"
                  IsChecked="True"
                  Checked="ProactiveSpeakCheckBox_Checked"
                  Unchecked="ProactiveSpeakCheckBox_Unchecked"/>
        <Grid Grid.Row="11">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="间隔" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Slider x:Name="ProactiveIntervalSlider"
                    Grid.Column="1"
                    Minimum="10"
                    Maximum="300"
                    Value="300"
                    TickFrequency="10"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    ValueChanged="ProactiveIntervalSlider_ValueChanged"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBox x:Name="ProactiveMinutesBox" Width="60" Height="26" FontSize="13" Text="5"/>
                <TextBlock Text="分钟" FontSize="12" Foreground="#666666" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 漫游 -->
        <Grid Grid.Row="12" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="RoamCheckBox"
                      Content="🐾 漫游"
                      FontWeight="Bold"
                      VerticalAlignment="Center"
                      Margin="0,0,10,0"
                      IsChecked="True"
                      Checked="RoamCheckBox_Checked"
                      Unchecked="RoamCheckBox_Unchecked"/>
            <Slider x:Name="RoamIntervalSlider"
                    Grid.Column="1"
                    Minimum="1"
                    Maximum="60"
                    Value="30"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    ValueChanged="RoamIntervalSlider_ValueChanged"/>
            <TextBlock x:Name="RoamIntervalValueText"
                       Grid.Column="2"
                       Text="30 秒"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="13"
                       TextAlignment="Right"/>
        </Grid>

        <!-- 开机自启 -->
        <CheckBox x:Name="AutoStartCheckBox"
                  Grid.Row="13"
                  Content="🚀 开机自启"
                  FontWeight="Bold"
                  Margin="0,12,0,0"
                  HorizontalAlignment="Left"/>

        <!-- 最大记忆轮数 -->
        <Grid Grid.Row="14" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="🧠 最大记忆轮数" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="HistoryRoundsCombo" Grid.Column="1" Height="28" VerticalAlignment="Center" SelectedIndex="0">
                <ComboBoxItem Content="10 轮"/>
                <ComboBoxItem Content="5 轮"/>
                <ComboBoxItem Content="0 轮（无记忆）"/>
            </ComboBox>
        </Grid>

        <!-- 最大回复字数 -->
        <Grid Grid.Row="15" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="📏 最大回复字数" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="ReplyLengthModeCombo" Grid.Column="1" Height="28" VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="ReplyLengthModeCombo_SelectionChanged">
                <ComboBoxItem Content="无限制"/>
                <ComboBoxItem Content="自定义"/>
            </ComboBox>
            <TextBox x:Name="ReplyLengthBox" Grid.Column="2" Width="70" Height="26" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" Text="100" IsEnabled="False"/>
        </Grid>

        <!-- 深度思考开关 -->
        <Grid Grid.Row="16" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="ThinkingCheckBox"
                      Content="🧠 深度思考（开启更聪明但回复慢，关闭秒回省 token）"
                      FontWeight="Bold"
                      VerticalAlignment="Center"
                      IsChecked="True"
                      Checked="ThinkingCheckBox_Checked"
                      Unchecked="ThinkingCheckBox_Unchecked"/>
        </Grid>

        <!-- 长期记忆 -->
        <Grid Grid.Row="17" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="LongTermMemoryCheckBox"
                      Content="🧠 长期记忆（AI 自动总结，写入 Memory.txt）"
                      FontWeight="Bold"
                      VerticalAlignment="Center"
                      IsChecked="False"
                      Checked="LongTermMemoryCheckBox_Checked"
                      Unchecked="LongTermMemoryCheckBox_Unchecked"/>
            <Button Grid.Column="1"
                    x:Name="OpenMemoryButton"
                    Content="📄 打开记忆文档"
                    Width="120"
                    Height="28"
                    FontSize="12"
                    Click="OpenMemoryButton_Click"
                    Background="#5B8DEF"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </Grid>

        <!-- 记忆字数 -->
        <Grid Grid.Row="18" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="📏 每条记忆字数" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Slider x:Name="MemoryMaxCharsSlider"
                    Grid.Column="1"
                    Minimum="10"
                    Maximum="100"
                    Value="40"
                    TickFrequency="5"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    ValueChanged="MemoryMaxCharsSlider_ValueChanged"/>
            <TextBlock x:Name="MemoryMaxCharsValueText"
                       Grid.Column="2"
                       Text="40 字"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="13"
                       TextAlignment="Right"/>
        </Grid>

        <!-- 启动欢迎语 -->
        <TextBlock Grid.Row="19" 
                   Text="👋 启动欢迎语（4 条，启动时随机显示一条）" 
                   FontWeight="Bold" 
                   Margin="0,12,0,5"/>
        <TextBox x:Name="Welcome1Box" Grid.Row="20" Height="26" FontSize="13" Margin="0,0,0,4"/>
        <TextBox x:Name="Welcome2Box" Grid.Row="21" Height="26" FontSize="13" Margin="0,0,0,4"/>
        <TextBox x:Name="Welcome3Box" Grid.Row="22" Height="26" FontSize="13" Margin="0,0,0,4"/>
        <TextBox x:Name="Welcome4Box" Grid.Row="23" Height="26" FontSize="13" Margin="0,0,0,4"/>

        <!-- 状态提示 -->
        <TextBlock x:Name="StatusText" 
                   Grid.Row="24" 
                   Text="" 
                   Foreground="#4CAF50"
                   FontSize="12"
                   Margin="0,12,0,10"
                   VerticalAlignment="Top"/>

        <!-- 按钮 -->
        <StackPanel Grid.Row="25" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="💾 保存" 
                    Width="90" 
                    Height="32" 
                    Click="SaveButton_Click"
                    Background="#4CAF50"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    FontSize="13"/>
            <Button Content="取消" 
                    Width="80" 
                    Height="32" 
                    Margin="10,0,0,0"
                    Click="CancelButton_Click"
                    Background="#666666"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    FontSize="13"/>
        </StackPanel>

        <!-- 作者署名 -->
        <TextBlock Grid.Row="26"
                   Text="作者:何意_味,b站uid:455294722"
                   FontSize="11"
                   Foreground="#AAAAAA"
                   Margin="0,10,0,0"
                   HorizontalAlignment="Center"/>
    </Grid>
    </ScrollViewer>
</Window>
